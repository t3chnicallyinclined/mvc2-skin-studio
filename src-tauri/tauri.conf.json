{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MVC2 Skin Studio",
  "version": "0.1.0",
  "identifier": "com.tristech.mvc2skinstudio",
  "build": {
    "frontendDist": "wwwroot",
    "beforeDevCommand": "node scripts/stage-frontend.mjs",
    "beforeBuildCommand": "node scripts/stage-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MVC2 Skin Studio",
        "url": "skin-studio.html",
        "width": 1180,
        "height": 1000,
        "minWidth": 1000,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
